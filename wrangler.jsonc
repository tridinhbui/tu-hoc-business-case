{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name connected to Workers Builds in the dashboard.
  "name": "tu-hoc-business-case",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Lets a plain `npx wrangler deploy` (the Workers Builds default, no build command) build the SPA first.
  // Must not call `wrangler types` or `npm run build`: wrangler runs this custom build for `wrangler types`
  // too, which would recurse forever. The Vite plugin ignores `build` and `assets.directory` during dev/build.
  "build": { "command": "npx vite build" },

  // React SPA built by Vite into dist/client.
  // /api/* always reaches the Worker; every other path is served index.html.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Safe production defaults. Local overrides live in .dev.vars (DEV_MODE, TURNSTILE_SECRET).
  "vars": {
    "DEV_MODE": "false",
    "APP_ORIGIN": "https://tu-hoc-business-case.tridinhbui0901.workers.dev",
    "MAIL_FROM": "no-reply@example.com",
    // Google OAuth client id (public by design). The secret is a Worker secret: wrangler secret put GOOGLE_CLIENT_SECRET
    "GOOGLE_CLIENT_ID": "",
    // Public Turnstile sitekey; empty until the widget exists (the login form then shows that sign-in is closed).
    "TURNSTILE_SITEKEY": "",
    // Frontend hostnames siteverify must report in production. Never add localhost here.
    "TURNSTILE_HOSTNAMES": "tu-hoc-business-case.tridinhbui0901.workers.dev"
  },

  // No resource ids: `wrangler deploy` provisions D1, KV, R2 and Queues that do not exist yet
  // and links them to the Worker on every later deploy.
  "d1_databases": [
    { "binding": "DB_CONTENT", "database_name": "bc_content", "migrations_dir": "migrations/content" },
    { "binding": "DB_LEARNING", "database_name": "bc_learning", "migrations_dir": "migrations/learning" }
  ],
  "kv_namespaces": [
    { "binding": "CONTENT_CACHE" },
    { "binding": "SESSIONS" }
  ],
  "r2_buckets": [
    { "binding": "R2_CONTENT", "bucket_name": "bc-content" },
    { "binding": "R2_SUBMISSIONS", "bucket_name": "bc-submissions" }
  ],

  "durable_objects": { "bindings": [ { "name": "LIVE_ROOM", "class_name": "LiveRoom" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["LiveRoom"] } ],

  "queues": {
    "producers": [
      { "binding": "Q_GRADING", "queue": "bc-grading" },
      { "binding": "Q_READINESS", "queue": "bc-readiness" }
    ],
    "consumers": [
      { "queue": "bc-grading", "max_batch_size": 10, "max_batch_timeout": 1,
        "max_retries": 5, "dead_letter_queue": "bc-grading-dlq" },
      { "queue": "bc-readiness", "max_batch_size": 50, "max_batch_timeout": 1,
        "max_retries": 5, "dead_letter_queue": "bc-readiness-dlq" }
    ]
  },

  // 19:00 UTC = 02:00 Asia/Ho_Chi_Minh
  "triggers": { "crons": ["0 19 * * *", "*/15 * * * *"] }

  // Added once a Cloudflare DNS domain and a Paid account exist:
  //   "send_email": [ { "name": "EMAIL" } ],
  //   "stream": { "binding": "STREAM" }
}
