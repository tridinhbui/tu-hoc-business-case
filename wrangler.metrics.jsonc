// TẠM TẮT: đổi tên từ wrangler.jsonc vì bản build đầu tiên trên Workers Builds thất bại
// (chưa đọc được log). Đổi lại thành wrangler.jsonc khi đã sửa xong để bật /api/metrics.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker của nhánh main (Tự học Business Case). Nền tảng ở nhánh cloudflare-platform dùng Worker riêng
  // "tu-hoc-business-case-app", nên hai bên không ghi đè nhau.
  "name": "tu-hoc-business-case",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Site tĩnh phục vụ nguyên thư mục gốc như trước khi có file cấu hình này.
  // Chỉ /api/* chạy qua Worker; mọi đường dẫn khác vẫn trả file tĩnh.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Kho số liệu: Durable Object dùng SQLite, không cần tạo tài nguyên trước trên dashboard.
  "durable_objects": {
    "bindings": [{ "name": "METRICS", "class_name": "MetricsStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MetricsStore"] }]

  // Bí mật cho trang admin, đặt một lần: npx wrangler secret put ADMIN_TOKEN
  // Khi chạy thử trên máy: tạo file .dev.vars với dòng ADMIN_TOKEN=...
}
